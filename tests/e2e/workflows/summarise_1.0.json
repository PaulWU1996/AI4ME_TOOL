{
  "workflow": {
    "name": "summarise",
    "version": "1.0"
  },
  "settings": {
    "on_failure": "stop",
    "retry_backoff": 1.0
  },
  "tasks": [
    {
      "id": "download",
      "task": "download_file",
      "depends_on": [],
      "retries": 3
    },
    {
      "id": "to_text",
      "task": "transcript_to_text",
      "depends_on": [
        "download"
      ]
    },
    {
      "id": "summarise",
      "task": "process_summarise",
      "depends_on": [
        "to_text"
      ],
      "service": "transcriptservice"
    },
    {
      "id": "tagging",
      "task": "process_tags",
      "depends_on": [
        "summarise"
      ],
      "service": "taggingservice"
    },
    {
      "id": "final",
      "task": "finalize_results",
      "depends_on": [
        "tagging"
      ],
      "kwargs": {
        "expects": [
          "summarise",
          "tagging"
        ]
      }
    }
  ]
}