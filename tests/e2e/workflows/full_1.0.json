{
  "workflow": {
    "name": "full",
    "version": "1.0"
  },
  "settings": {
    "on_failure": "stop",
    "retry_backoff": 1.0
  },
  "tasks": [
    {
      "id": "download",
      "task": "download_file",
      "depends_on": [],
      "retries": 3
    },
    {
      "id": "visual",
      "task": "process_visual",
      "depends_on": [
        "download"
      ],
      "service": "visualservice"
    },
    {
      "id": "audio",
      "task": "process_audio",
      "depends_on": [
        "visual"
      ],
      "service": "audioservice"
    },
    {
      "id": "final",
      "task": "finalize_results",
      "depends_on": [
        "visual",
        "audio"
      ],
      "kwargs": {
        "expects": [
          "audio",
          "visual"
        ]
      }
    }
  ]
}