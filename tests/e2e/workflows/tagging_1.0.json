{
  "workflow": {
    "name": "tagging",
    "version": "1.0"
  },
  "settings": {
    "on_failure": "stop",
    "retry_backoff": 1.0
  },
  "tasks": [
    {
      "id": "download",
      "task": "download_file",
      "retries": 3,
      "depends_on": []
    },
    {
      "id": "to_text",
      "task": "transcript_to_text",
      "depends_on": [
        "download"
      ]
    },
    {
      "id": "tagging",
      "task": "process_tags",
      "service": "taggingservice",
      "depends_on": [
        "to_text"
      ]
    },
    {
      "id": "final",
      "task": "finalize_results",
      "kwargs": {
        "expects": [
          "tagging"
        ]
      },
      "depends_on": [
        "tagging"
      ]
    }
  ]
}