{
  "workflow": {
    "name": "content-avoidance",
    "version": "1.0"
  },
  "settings": {
    "on_failure": "stop",
    "retry_backoff": 1.0
  },
  "tasks": [
    {
      "id": "scene-classifcation",
      "driver": "http",
      "url": "http://localhost:8080/analyse",
      "timeout": 300,
      "merge": true
    },
    {
      "id": "audio-transcription",
      "driver": "http",
      "url": "http://localhost:9004/process",
      "body": {
        "storage_type": "mongodb"
      },
      "timeout": 300,
      "merge": true
    }
  ]
}
