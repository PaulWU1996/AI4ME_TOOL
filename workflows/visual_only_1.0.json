{
  "workflow": {
    "name": "visual_only",
    "version": "1.0"
  },
  "settings": {
    "on_failure": "stop",
    "retry_backoff": 1.0
  },
  "tasks": [
    {
      "id": "download",
      "task": "download_file",
      "call": "kwargs",
      "inject": [
        "path",
        "prompts",
        "job_id"
      ],
      "requires": [
        "path"
      ],
      "depends_on": [],
      "retries": 3
    },
    {
      "id": "visual",
      "task": "process_visual",
      "service": "visualservice",
      "depends_on": [
        "download"
      ]
    },
    {
      "id": "final",
      "task": "finalize_results",
      "call": "kwargs",
      "inject": [
        "job_id",
        "job_type",
        "callback_url"
      ],
      "terminal": true,
      "kwargs": {
        "expects": [
          "visual"
        ]
      },
      "depends_on": [
        "visual"
      ]
    }
  ]
}