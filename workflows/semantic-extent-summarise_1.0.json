{
  "workflow": {
    "name": "semantic-extent-summarise",
    "version": "1.0"
  },
  "settings": {
    "on_failure": "stop",
    "retry_backoff": 1.0
  },
  "tasks": [
    {
      "id": "download",
      "task": "download_file",
      "call": "kwargs",
      "inject": [
        "path",
        "prompts",
        "job_id"
      ],
      "requires": [
        "path"
      ],
      "depends_on": [],
      "retries": 3
    },
    {
      "id": "extent",
      "driver": "http",
      "url": "http://audiotranscriptionservice:8000/process",
      "body": {
        "job_type": "semantic_extent"
      },
      "timeout": 600,
      "merge": true,
      "depends_on": [
        "download"
      ]
    },
    {
      "id": "transcript",
      "driver": "http",
      "url": "http://audiotranscriptionservice:8000/process",
      "body": {
        "job_type": "transcript_to_text"
      },
      "timeout": 300,
      "merge": true,
      "depends_on": [
        "extent"
      ]
    },
    {
      "id": "summarise",
      "driver": "http",
      "url": "http://transcriptservice:8000/process",
      "body": {
        "job_type": "summary"
      },
      "merge": true,
      "save": "summarise_output",
      "timeout": 1800,
      "depends_on": [
        "transcript"
      ]
    },
    {
      "id": "tagging",
      "driver": "http",
      "url": "http://transcriptservice:8000/process",
      "body": {
        "job_type": "tagging"
      },
      "merge": true,
      "save": "tagging_output",
      "timeout": 1800,
      "depends_on": [
        "summarise"
      ]
    },
    {
      "id": "final",
      "task": "finalize_results",
      "call": "kwargs",
      "inject": [
        "job_id",
        "job_type",
        "callback_url"
      ],
      "terminal": true,
      "kwargs": {
        "expects": [
          "extent",
          "summarise",
          "tagging"
        ]
      },
      "depends_on": [
        "extent",
        "summarise",
        "tagging"
      ]
    }
  ]
}
